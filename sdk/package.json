{
  "name": "@capnet-auth/sdk",
  "version": "0.1.0",
  "description": "SDK for CapNet capability-based authorization — builder API, typed errors, auto-identity",
  "license": "MIT",
  "author": "Conner Levi",
  "repository": {
    "type": "git",
    "url": "https://github.com/Connerlevi/CapNET.git",
    "directory": "sdk"
  },
  "keywords": ["capnet", "capabilities", "authorization", "ai-agents", "sdk"],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "demo": "node ../node_modules/tsx/dist/cli.mjs src/demo.ts",
    "demo:runaway": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/runaway-agent.ts",
    "demo:hijack": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/agent-hijack.ts",
    "demo:company": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/multi-agent-company.ts",
    "demo:all": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/run-all.ts",
    "demo:openclaw": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/openclaw-hijack.ts",
    "demo:github": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/github-mcp.ts",
    "demo:slack": "node ../node_modules/tsx/dist/cli.mjs src/scenarios/slack-mcp.ts"
  },
  "dependencies": {
    "@capnet-auth/shared": "0.1.0"
  },
  "devDependencies": {
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
