# CapNet Environment Variables
# All variables are optional — defaults work for local development.

# Server ports
# PORT=3100          # Proxy server (set per-workspace)
# PORT=3200          # Sandbox server (set per-workspace)

# Proxy configuration
# CAPNET_DATA_DIR=./data                # Where caps, receipts, and keys are stored
# CAPNET_MAX_DELEGATION_DEPTH=3         # Max delegation chain depth (security limit)

# Test / demo overrides (useful for CI or custom setups)
# PROXY_URL=http://127.0.0.1:3100      # Override proxy URL in tests/demos
# SANDBOX_URL=http://127.0.0.1:3200    # Override sandbox URL in tests/demos
